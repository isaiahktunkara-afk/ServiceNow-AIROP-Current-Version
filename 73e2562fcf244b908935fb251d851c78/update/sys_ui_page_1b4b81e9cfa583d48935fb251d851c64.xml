<script type="text/javascript">
var moduleNames = {
    'AIOPS': 'IT Operations',
    'CMDB': 'Configuration Management Database',
    'CREATOR': 'Creator',
    'CSM': 'Customer Service Management',
    'DEX': 'Digital End-User Experience',
    'FIELD_SERVICE': 'Field Service Management',
    'GRC': 'Governance Risk Compliance',
    'HAM': 'Hardware Asset Management',
    'HRSD': 'Human Resources Service Delivery',
    'HS': 'Health &amp; Safety',
    'ITOM': 'IT Operations Management',
    'ITSM': 'IT Service Management',
    'LSD': 'Legal Service Delivery',
    'OTSM': 'OT Service Management',
    'PLATFORM': 'Platform Foundation',
    'SECOPS': 'Security Operations',
    'SAM': 'Software Asset Management',
    'SPM': 'Strategic Portfolio Management',
    'SPO': 'Sourcing Procurement',
    'TPRM': 'Third Party Risk Management',
    'VIRTUAL_AGENT': 'Virtual Agent',
    'WSD': 'Workplace Service Delivery'
};

var settings = {};
try {
    var jsonStr = '${jvar_modules_json}';
    if (jsonStr) {
        if (jsonStr.length > 0) {
            if (jsonStr.indexOf('{') === 0) {
                settings = JSON.parse(jsonStr);
            }
        }
    }
} catch(e) {
    console.error('Error parsing module settings: ' + e);
    settings = {};
}

// Check if returning from save (success message)
window.addEventListener('load', function() {
    var urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('airop_settings_saved') === 'true') {
        var msg = document.getElementById('successMessage');
        if (msg) {
            msg.style.display = 'block';
            setTimeout(function() {
                msg.style.display = 'none';
            }, 5000);
        }
        // Clean up the URL
        window.history.replaceState({}, document.title, window.location.pathname);
    }
});

var grid = document.getElementById('modulesGrid');
var moduleKeys = Object.keys(moduleNames).sort(function(a, b) {
    return moduleNames[a].localeCompare(moduleNames[b]);
});

moduleKeys.forEach(function(key) {
    var div = document.createElement('div');
    div.style.display = 'flex';
    div.style.alignItems = 'center';
    div.style.gap = '10px';
    
    var checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.id = 'module_' + key;
    checkbox.name = 'module_' + key;
    checkbox.value = 'true';
    checkbox.checked = settings[key] === true;
    
    var label = document.createElement('label');
    label.htmlFor = 'module_' + key;
    label.textContent = moduleNames[key];
    label.style.cursor = 'pointer';
    label.style.fontSize = '14px';
    label.style.margin = '0';
    
    div.appendChild(checkbox);
    div.appendChild(label);
    grid.appendChild(div);
});

function enableAll() {
    var checkboxes = document.querySelectorAll('input[type=checkbox]');
    checkboxes.forEach(function(cb) {
        cb.checked = true;
    });
}

function disableAll() {
    var checkboxes = document.querySelectorAll('input[type=checkbox]');
    checkboxes.forEach(function(cb) {
        cb.checked = false;
    });
}

function handleFormSubmit(event) {
    // Show loading overlay
    var overlay = document.getElementById('loadingOverlay');
    if (overlay) {
        overlay.style.display = 'flex';
    }
    
    // Disable buttons
    var saveBtn = document.getElementById('saveBtn');
    var enableBtn = document.getElementById('enableAllBtn');
    var disableBtn = document.getElementById('disableAllBtn');
    
    if (saveBtn) saveBtn.disabled = true;
    if (enableBtn) enableBtn.disabled = true;
    if (disableBtn) disableBtn.disabled = true;
    
    // Form submission continues normally
}
</script>
</j:jelly>]]></html>
