        <processing_script><![CDATA[(function() {
    
    var airop_action = request.getParameter("airop_action");

    
    if (airop_action != "save_settings") {

        return;
    }


    var pMap = {
        'ITSM': 'x_snc_airop.module.ITSM.enabled',
        'ITOM': 'x_snc_airop.module.ITOM.enabled',
        'CMDB': 'x_snc_airop.module.CMDB.enabled',
        'HRSD': 'x_snc_airop.module.HRSD.enabled',
        'CSM': 'x_snc_airop.module.CSM.enabled',
        'FIELD_SERVICE': 'x_snc_airop.module.FIELD_SERVICE.enabled',
        'AIOPS': 'x_snc_airop.module.AIOPS.enabled',
        'GRC': 'x_snc_airop.module.GRC.enabled',
        'SPM': 'x_snc_airop.module.SPM.enabled',
        'PLATFORM': 'x_snc_airop.module.PLATFORM.enabled',
        'VIRTUAL_AGENT': 'x_snc_airop.module.VIRTUAL_AGENT.enabled',
        'DEX': 'x_snc_airop.module.DEX.enabled',
        'SECOPS': 'x_snc_airop.module.SECOPS.enabled',
        'HS': 'x_snc_airop.module.HS.enabled',
        'OTSM': 'x_snc_airop.module.OTSM.enabled',
        'CREATOR': 'x_snc_airop.module.CREATOR.enabled',
        'SPO': 'x_snc_airop.module.SPO.enabled',
        'TPRM': 'x_snc_airop.module.TPRM.enabled',
        'LSD': 'x_snc_airop.module.LSD.enabled',
        'WSD': 'x_snc_airop.module.WSD.enabled',
        'HAM': 'x_snc_airop.module.HAM.enabled',
        'SAM': 'x_snc_airop.module.SAM.enabled'
    };


    // Loop through all modules and set their properties based on form data
    var updateCount = 0;
    for (var module in pMap) {
        var propName = pMap[module];
        var checkboxName = 'module_' + module;
        var formValue = request.getParameter(checkboxName);
        
        // Checkbox is checked if formValue is 'true'
        var isChecked = (formValue === 'true');
        var newValue = isChecked ? 'true' : 'false';
        
        gs.setProperty(propName, newValue);
        updateCount++;
    }
    
    response.setRedirectURL("x_snc_airop_airop_settings.do?airop_settings_saved=true");

})();]]></processing_script>
