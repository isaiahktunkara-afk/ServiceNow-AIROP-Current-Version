    'HRSD':'x_snc_airop.module.HRSD.enabled',
    'CSM':'x_snc_airop.module.CSM.enabled',
    'FIELD_SERVICE':'x_snc_airop.module.FIELD_SERVICE.enabled',
    'AIOPS':'x_snc_airop.module.AIOPS.enabled',
    'GRC':'x_snc_airop.module.GRC.enabled',
    'SPM':'x_snc_airop.module.SPM.enabled',
    'PLATFORM':'x_snc_airop.module.PLATFORM.enabled',
    'VIRTUAL_AGENT':'x_snc_airop.module.VIRTUAL_AGENT.enabled',
    'DEX':'x_snc_airop.module.DEX.enabled',
