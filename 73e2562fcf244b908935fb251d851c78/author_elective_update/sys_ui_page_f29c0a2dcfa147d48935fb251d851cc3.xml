    gs.info('[TEST PS] ========== TEST ACTION DETECTED ==========');
    gs.info('[TEST PS] Setting test property...');
    
    gs.setProperty('x_snc_airop.test_processor_ran', 'true');
    
    gs.info('[TEST PS] Property set. Now logging user info...');
    gs.info('[TEST PS] Current user: ' + gs.getUserName());
    gs.info('[TEST PS] Current scope: ' + gs.getCurrentScope());
    
    gs.addInfoMessage('SUCCESS! Processing Script ran at ' + new Date());
    
    gs.info('[TEST PS] ========== PROCESSING SCRIPT COMPLETE ==========');
    response.sendRedirect(request.getRequestURL());

})();]]></processing_script>
